# 唯一配置入口：复制为仓库/部署目录的 .env；不用创建 frontend/.env 或 backend/.env。
# 进程环境变量优先于文件。为兼容 docker run --env-file，请一行一个 KEY=value，
# 注释放在独立行，值不加外围引号、不使用变量展开。不要将密钥命名为 VITE_*。

# HTTP 与部署（容器内部端口固定，PORT 是宿主机端口）
PORT=4010
HOST_DATA_DIR=./data
WEB_CONCURRENCY=2
DEBUG=false
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Shanghai

# 本地后端和 Vite 开发服务器
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8020
VITE_DEV_PORT=4010
# 默认代理自动跟随 BACKEND_PORT；后端在另一台机器时才需要覆盖
# VITE_PROXY_TARGET=http://localhost:8020

# 数据路径：默认本地 backend/var/，Docker /app/data；一般无需修改。
# DATA_DIR / MEDIA_ROOT / BACKUP_ROOT 的相对路径相对于根 .env 所在目录。
# 相对 SQLite 文件相对于本地 backend/var/；容器默认使用绝对路径。
# DATABASE_URL=postgresql://user:password@database:5432/bbtalk
# DATA_DIR=./backend/var/data
# MEDIA_ROOT=./backend/var/media
# BACKUP_ROOT=./backend/var/data/backups

# 留空时复用 DATA_DIR/.secret_key；没有时生成并持久化。升级不要更换密钥。
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
CREATE_DEMO_USER=false
# 启用后在 init 时创建普通演示账号 demo / demo123，并写入 10 条记录、6 个标签、4 条评论。
# 已有 demo 账号会保留其密码和数据，不重复填充；关闭开关不会删除已有账号。
REGISTRATION_ENABLED=false
SESSION_COOKIE_SECURE=false

# 限流按每个后端进程计算；留空关闭对应限制
AUTH_LOGIN_RATE=30/minute
AUTH_REGISTRATION_RATE=5/minute
AUTH_REFRESH_RATE=120/minute
PASSWORD_RECOVERY_RATE=5/minute

# 跨域：同源部署通常无需调整；分离部署时填写实际前端地址
CORS_ALLOWED_ORIGINS=http://localhost:4010
CORS_ORIGIN_ALLOW_ALL=false
CORS_ALLOW_CREDENTIALS=true
ATTACHMENT_MAX_FILE_SIZE=10485760
IMPORT_MAX_FILE_SIZE=536870912
# Nginx 请求体上限，需大于上传/导入限制以容纳 multipart 开销；0 表示不限
NGINX_CLIENT_MAX_BODY_SIZE=513M

# 密码恢复邮件
PASSWORD_RECOVERY_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.invalid

# 前端公开配置：容器重建后刷新网页生效，预构建镜像也支持，无需重新编译前端。
# API 地址留空使用同源代理；通常无需修改。
VITE_API_BASE_URL=
VITE_SITE_NAME=BBTalk
VITE_SITE_COPYRIGHT=
VITE_PRIVACY_TIMEOUT_MINUTES=5
VITE_SHOW_PRIVACY_COUNTDOWN=true
VITE_MEDIA_URL_PROTOCOL=

# 可选构建参数：改变部署子路径需要重新构建前端并调整反向代理。
# VITE_BASE_PATH=/

# 自动部署重试与健康检查
DEPLOY_PULL_ATTEMPTS=3
DEPLOY_PULL_TIMEOUT=300
DEPLOY_HEALTH_ATTEMPTS=60
DEPLOY_RETRY_DELAY=5
DEPLOY_HEALTH_INTERVAL=2

# 宿主机定时备份：默认自动探测容器并备份全部账号，保留每账号最近 7 份。
BACKUP_CONTAINER=
BACKUP_KEEP=7
BACKUP_USER_ID=
BACKUP_DRY_RUN=false

# 可选全局 S3：前三项同时配置后作为默认存储；账号自己的存储配置优先。
# 留空时默认使用本地存储。签名链接有效期单位为秒。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=3600
